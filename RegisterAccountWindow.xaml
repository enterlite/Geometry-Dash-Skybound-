<Window x:Class="SkyboundLauncher.RegisterAccountWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Register Account" 
        Height="800" 
        Width="1400"
        WindowStartupLocation="CenterScreen"
        Background="#0f0f1e"
        Foreground="#ffffff"
        WindowStyle="None"
        AllowsTransparency="True"
        ResizeMode="CanResizeWithGrip"
        Loaded="Window_Loaded"
        Closing="Window_Closing">

    <Window.Resources>
        <!-- Purple-White Gradient Brush -->
        <LinearGradientBrush x:Key="PurpleWhiteGradient" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#9933FF" Offset="0"/>
            <GradientStop Color="#FFFFFF" Offset="1"/>
        </LinearGradientBrush>
    </Window.Resources>

    <Border BorderThickness="1" BorderBrush="#333333" CornerRadius="0">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="50"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Title bar -->
            <Border Grid.Row="0" Background="#1a1a2e99" BorderThickness="0,0,0,1" BorderBrush="{StaticResource PurpleWhiteGradient}" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Border.Effect>
                    <DropShadowEffect Color="#00d9ff" BlurRadius="8" ShadowDepth="0" Opacity="0.3"/>
                </Border.Effect>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Title -->
                    <TextBlock Grid.Column="0" Text="👤 Register Account" FontSize="16" Foreground="#00d9ff" VerticalAlignment="Center" Margin="20,0,0,0" FontWeight="Bold"/>

                    <!-- Close button -->
                    <Button Grid.Column="1" Content="✕" FontSize="18" Click="CloseButton_Click"
                           Background="#2a2a3e99" Foreground="#ff3333" Padding="15,10" 
                           BorderThickness="0" Cursor="Hand" Margin="10">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}" CornerRadius="6">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </Grid>
            </Border>

            <!-- WebView2 Content Container -->
            <Grid Grid.Row="1" x:Name="WebViewContainer" Margin="0"/>
        </Grid>
    </Border>
</Window>
