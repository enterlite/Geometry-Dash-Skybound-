<Window x:Class="SkyboundLauncher.CrashReportWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Report Game Error" 
        Height="350" 
        Width="600"
        Background="#1a1a1a"
        Foreground="#ffffff"
        FontFamily="Rubik"
        FontWeight="Medium"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Title -->
        <TextBlock Grid.Row="0" Text="Skybound+ - Error Report" FontSize="18" Foreground="#0066cc" 
                  FontWeight="Bold" Padding="20,15,20,10"/>

        <!-- Nick -->
        <Grid Grid.Row="1" Margin="20,0,20,15">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="80"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <TextBlock Text="Your nickname:" Foreground="#cccccc" VerticalAlignment="Center" Margin="0,0,10,0"/>
            <TextBox Grid.Column="1" x:Name="NickTextBox" Background="#252525" Foreground="#ffffff" 
                    BorderBrush="#0066cc" BorderThickness="1" Padding="10,8"/>
        </Grid>

        <!-- Error message -->
        <Grid Grid.Row="2" Margin="20,0,20,15">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <TextBlock Text="Error description:" Foreground="#cccccc" Margin="0,0,0,8"/>
            <TextBox Grid.Row="1" x:Name="ErrorMessageTextBox" Background="#252525" Foreground="#ffffff" 
                    BorderBrush="#0066cc" BorderThickness="1" Padding="10,8"
                    TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto"/>
        </Grid>

        <!-- Buttons -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="20,0,20,15" Height="40">
            <Button Content="Cancel" Click="Cancel_Click" Background="#404040" Foreground="White" 
                   Padding="20,8" BorderThickness="0" Cursor="Hand" Margin="0,0,10,0"/>
            <Button Content="Send" Click="Send_Click" Background="#0066cc" Foreground="White" 
                   Padding="20,8" BorderThickness="0" Cursor="Hand" x:Name="SendButton"/>
        </StackPanel>
    </Grid>
</Window>
