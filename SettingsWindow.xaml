<Window x:Class="SkyboundLauncher.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Nastavení Launcheru"
        Height="500"
        Width="600"
        Background="#0f0f1e"
        Foreground="#ffffff"
        WindowStyle="None"
        AllowsTransparency="True"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        BorderThickness="1"
        BorderBrush="#9933FF">

    <Window.Resources>
        <LinearGradientBrush x:Key="PurpleWhiteGradient" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#9933FF" Offset="0"/>
            <GradientStop Color="#FFFFFF" Offset="1"/>
        </LinearGradientBrush>
    </Window.Resources>

    <Border CornerRadius="10" Background="#1a1a2e" BorderThickness="1" BorderBrush="{StaticResource PurpleWhiteGradient}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="50"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="60"/>
            </Grid.RowDefinitions>

            <!-- Header s close tlačítkem -->
            <Border Grid.Row="0" Background="#0f0f1e" BorderThickness="0,0,0,1" BorderBrush="{StaticResource PurpleWhiteGradient}">
                <Grid>
                    <TextBlock Text="Nastavení Launcheru" FontSize="16" FontWeight="Bold" Foreground="#00d9ff" VerticalAlignment="Center" Margin="20,0"/>
                    <Button Content="✕" Click="CloseButton_Click" HorizontalAlignment="Right" Margin="10" Background="Transparent" Foreground="#ff6b6b" BorderThickness="0" Cursor="Hand" FontSize="14"/>
                </Grid>
            </Border>

            <!-- Obsah nastavení -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="20">
                <StackPanel Orientation="Vertical">

                    <!-- 1. Automatické aktualizace -->
                    <Border Background="#2a2a3e" Padding="15" BorderThickness="1" BorderBrush="{StaticResource PurpleWhiteGradient}" CornerRadius="8" Margin="0,0,0,20">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Orientation="Vertical" Grid.Column="0">
                                <TextBlock Text="Automatické aktualizace" FontSize="14" FontWeight="Bold" Foreground="#ffffff"/>
                                <TextBlock Text="Automaticky stáhnout nové verze hry" FontSize="12" Foreground="#b0b0c0" Margin="0,5,0,0"/>
                            </StackPanel>

                            <CheckBox x:Name="AutoUpdateCheckBox" Grid.Column="1" VerticalAlignment="Center" Foreground="#00d9ff" Checked="AutoUpdateCheckBox_Changed" Unchecked="AutoUpdateCheckBox_Changed"/>
                        </Grid>
                    </Border>

                    <!-- 2. Nastavení paměti a CPU -->
                    <Border Background="#2a2a3e" Padding="15" BorderThickness="1" BorderBrush="{StaticResource PurpleWhiteGradient}" CornerRadius="8" Margin="0,0,0,20">
                        <StackPanel Orientation="Vertical">
                            <TextBlock Text="Omezení Zdrojů" FontSize="14" FontWeight="Bold" Foreground="#ffffff"/>

                            <!-- RAM minimum -->
                            <Grid Margin="0,0,0,15">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="100"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Minimální RAM: " Foreground="#b0b0c0" VerticalAlignment="Center"/>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,0,0">
                                    <Slider x:Name="MinRamSlider" Width="60" Minimum="30" Maximum="100" Value="30" Foreground="#00d9ff" Background="#333333" ValueChanged="MinRamSlider_ValueChanged" Margin="0,0,10,0"/>
                                    <TextBlock x:Name="MinRamText" Text="30 MB" Foreground="#00d9ff" Width="50" TextAlignment="Right"/>
                                </StackPanel>
                            </Grid>

                            <!-- RAM maximum -->
                            <Grid Margin="0,0,0,15">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="100"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Maximální RAM: " Foreground="#b0b0c0" VerticalAlignment="Center"/>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,0,0">
                                    <Slider x:Name="MaxRamSlider" Width="60" Minimum="100" Maximum="500" Value="250" Foreground="#00d9ff" Background="#333333" ValueChanged="MaxRamSlider_ValueChanged" Margin="0,0,10,0"/>
                                    <TextBlock x:Name="MaxRamText" Text="250 MB" Foreground="#00d9ff" Width="50" TextAlignment="Right"/>
                                </StackPanel>
                            </Grid>

                            <!-- CPU minimum -->
                            <Grid Margin="0,0,0,15">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="100"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Minimální CPU: " Foreground="#b0b0c0" VerticalAlignment="Center"/>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,0,0">
                                    <Slider x:Name="MinCpuSlider" Width="60" Minimum="5" Maximum="20" Value="10" Foreground="#00d9ff" Background="#333333" ValueChanged="MinCpuSlider_ValueChanged" Margin="0,0,10,0"/>
                                    <TextBlock x:Name="MinCpuText" Text="10 %" Foreground="#00d9ff" Width="50" TextAlignment="Right"/>
                                </StackPanel>
                            </Grid>

                            <!-- CPU maximum -->
                            <Grid Margin="0,0,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="100"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Maximální CPU: " Foreground="#b0b0c0" VerticalAlignment="Center"/>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,0,0">
                                    <Slider x:Name="MaxCpuSlider" Width="60" Minimum="30" Maximum="100" Value="40" Foreground="#00d9ff" Background="#333333" ValueChanged="MaxCpuSlider_ValueChanged" Margin="0,0,10,0"/>
                                    <TextBlock x:Name="MaxCpuText" Text="40 %" Foreground="#00d9ff" Width="50" TextAlignment="Right"/>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- 3. Cesta k hře -->
                    <Border Background="#2a2a3e" Padding="15" BorderThickness="1" BorderBrush="{StaticResource PurpleWhiteGradient}" CornerRadius="8" Margin="0,0,0,20">
                        <StackPanel Orientation="Vertical" Margin="0,0,0,10">
                            <TextBlock Text="Umístění Hry" FontSize="14" FontWeight="Bold" Foreground="#ffffff" Margin="0,0,0,10"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="100"/>
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="GamePathTextBox" Grid.Column="0" Background="#1a1a2e" Foreground="#ffffff" BorderBrush="{StaticResource PurpleWhiteGradient}" BorderThickness="1" Padding="10" VerticalAlignment="Center"/>
                                <Button Content="Procházet..." Grid.Column="1" Margin="10,0,0,0" Click="BrowseButton_Click" Background="#00d9ff" Foreground="#0f0f1e" BorderThickness="0" Cursor="Hand" Padding="10,5"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                </StackPanel>
            </ScrollViewer>

            <!-- Footer s tlačítky -->
            <Border Grid.Row="2" Background="#0f0f1e" BorderThickness="0,1,0,0" BorderBrush="{StaticResource PurpleWhiteGradient}">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="20">
                    <Button Content="Zrušit" Click="CancelButton_Click" Background="#2a2a3e" Foreground="#ffffff" BorderThickness="1" BorderBrush="{StaticResource PurpleWhiteGradient}" Padding="20,10" Cursor="Hand" Margin="0,0,10,0"/>
                    <Button Content="Uložit" Click="SaveButton_Click" Background="#00d9ff" Foreground="#0f0f1e" BorderThickness="0" Padding="20,10" Cursor="Hand" FontWeight="Bold"/>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>
