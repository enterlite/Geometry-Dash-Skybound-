<Application x:Class="SkyboundLauncher.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:SkyboundLauncher"
             StartupUri="SplashScreen.xaml">
    <Application.Resources>
        <!-- ===== CUSTOM FONTS ===== -->
        <FontFamily x:Key="ChillaxFont">pack://application:,,,/fonts/Chillax_Complete/Fonts/OTF/#Chillax Medium</FontFamily>
        
        <!-- ===== BARVY - GLASSMORPHIC DARK MODE ===== -->
        <SolidColorBrush x:Key="PrimaryBrush" Color="#00d9ff"/>
        <SolidColorBrush x:Key="PrimaryDarkBrush" Color="#0099cc"/>
        <SolidColorBrush x:Key="SecondaryBrush" Color="#2a2a3e"/>
        <SolidColorBrush x:Key="BackgroundBrush" Color="#0f0f1e"/>
        <SolidColorBrush x:Key="SurfaceBrush" Color="#1a1a2e"/>
        <SolidColorBrush x:Key="GlassBrush" Color="#1f1f3e"/>
        <SolidColorBrush x:Key="ForegroundBrush" Color="#ffffff"/>
        <SolidColorBrush x:Key="TextSecondaryBrush" Color="#b0b0c0"/>
        <SolidColorBrush x:Key="ErrorBrush" Color="#ff6b6b"/>
        <SolidColorBrush x:Key="SuccessBrush" Color="#51cf66"/>
        <SolidColorBrush x:Key="WarningBrush" Color="#ffa92d"/>
        
        <!-- ===== PURPLE-WHITE GRADIENT BRUSH ===== -->
        <LinearGradientBrush x:Key="PurpleWhiteGradient" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#9933FF" Offset="0"/>
            <GradientStop Color="#FFFFFF" Offset="1"/>
        </LinearGradientBrush>
        
        <!-- ===== ANIMACE - FADE IN ===== -->
        <Storyboard x:Key="FadeInAnimation">
            <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.5" />
        </Storyboard>

        <!-- ===== BORDER STYLE - GLASSMORPHIC ===== -->
        <Style x:Key="GlassmorphicBorderStyle" TargetType="Border">
            <Setter Property="Background" Value="#1f1f3e99"/>
            <Setter Property="BorderBrush" Value="{StaticResource PurpleWhiteGradient}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect Color="#000000" BlurRadius="15" ShadowDepth="8" Opacity="0.5"/>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="ModernPrimaryButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#00d9ff"/>
            <Setter Property="Foreground" Value="#0f0f1e"/>
            <Setter Property="Padding" Value="24,14"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" 
                                Background="{TemplateBinding Background}" 
                                CornerRadius="10"
                                Padding="{TemplateBinding Padding}">
                            <Border.Effect>
                                <DropShadowEffect Color="#00d9ff" BlurRadius="12" ShadowDepth="0" Opacity="0"/>
                            </Border.Effect>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" TextBlock.Foreground="{TemplateBinding Foreground}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <ColorAnimation Storyboard.TargetName="border" Storyboard.TargetProperty="Background.Color" To="#00b8d4" Duration="0:0:0.2"/>
                                            <DoubleAnimation Storyboard.TargetName="border" Storyboard.TargetProperty="Effect.Opacity" To="0.8" Duration="0:0:0.2"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <ColorAnimation Storyboard.TargetName="border" Storyboard.TargetProperty="Background.Color" To="#00d9ff" Duration="0:0:0.2"/>
                                            <DoubleAnimation Storyboard.TargetName="border" Storyboard.TargetProperty="Effect.Opacity" To="0" Duration="0:0:0.2"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#0099aa"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Background" Value="#555566"/>
                                <Setter Property="Foreground" Value="#888899"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ===== SECONDARY BUTTON - GLASSMORPHIC ===== -->
        <Style x:Key="ModernSecondaryButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#2a2a3e99"/>
            <Setter Property="Foreground" Value="#ffffff"/>
            <Setter Property="Padding" Value="18,11"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="{StaticResource PurpleWhiteGradient}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" 
                                Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <Border.Effect>
                                <DropShadowEffect Color="#00d9ff" BlurRadius="8" ShadowDepth="0" Opacity="0"/>
                            </Border.Effect>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" TextBlock.Foreground="{TemplateBinding Foreground}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <ColorAnimation Storyboard.TargetName="border" Storyboard.TargetProperty="Background.Color" To="#3a3a4e" Duration="0:0:0.2"/>
                                            <DoubleAnimation Storyboard.TargetName="border" Storyboard.TargetProperty="Effect.Opacity" To="0.6" Duration="0:0:0.2"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <ColorAnimation Storyboard.TargetName="border" Storyboard.TargetProperty="Background.Color" To="#2a2a3e" Duration="0:0:0.2"/>
                                            <DoubleAnimation Storyboard.TargetName="border" Storyboard.TargetProperty="Effect.Opacity" To="0" Duration="0:0:0.2"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#1a1a2e"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ===== TAB BUTTON STYLE ===== -->
        <Style x:Key="TabButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#b0b0c0"/>
            <Setter Property="Padding" Value="16,8"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Border x:Name="bg" Background="{TemplateBinding Background}" CornerRadius="6"/>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" TextBlock.Foreground="{TemplateBinding Foreground}"/>
                            <Border x:Name="underline" Height="2" VerticalAlignment="Bottom" Background="Transparent" CornerRadius="1"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="#2a2a3e80"/>
                                <Setter Property="Foreground" Value="#00d9ff"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ===== GLOBAL STYLE FOR WINDOW ===== -->
        <Style TargetType="Window">
            <Setter Property="FontFamily" Value="{StaticResource ChillaxFont}"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>

        <!-- ===== GLOBAL STYLE FOR TEXTBLOCK ===== -->
        <Style TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource ChillaxFont}"/>
        </Style>

        <!-- ===== GLOBAL STYLE FOR TEXTBOX ===== -->
        <Style TargetType="TextBox">
            <Setter Property="FontFamily" Value="{StaticResource ChillaxFont}"/>
        </Style>

        <!-- ===== GLOBAL STYLE FOR BUTTON ===== -->
        <Style TargetType="Button">
            <Setter Property="FontFamily" Value="{StaticResource ChillaxFont}"/>
        </Style>

    </Application.Resources>
</Application>
