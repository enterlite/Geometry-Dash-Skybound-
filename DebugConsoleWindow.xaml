<Window x:Class="SkyboundLauncher.DebugConsoleWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Debug Console" 
        Height="800" 
        Width="1400"
        WindowStartupLocation="CenterScreen"
        Background="#0f0f1e"
        Foreground="#ffffff"
        WindowStyle="None"
        AllowsTransparency="True"
        ResizeMode="CanResizeWithGrip"
        Loaded="Window_Loaded"
        Closing="Window_Closing">

    <Window.Resources>
        <!-- Purple-White Gradient Brush -->
        <LinearGradientBrush x:Key="PurpleWhiteGradient" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#9933FF" Offset="0"/>
            <GradientStop Color="#FFFFFF" Offset="1"/>
        </LinearGradientBrush>
    </Window.Resources>

    <Border BorderThickness="1" BorderBrush="#333333" CornerRadius="0">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="50"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Title bar -->
            <Border Grid.Row="0" Background="#1a1a2e99" BorderThickness="0,0,0,1" BorderBrush="{StaticResource PurpleWhiteGradient}" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Border.Effect>
                    <DropShadowEffect Color="#00d9ff" BlurRadius="8" ShadowDepth="0" Opacity="0.3"/>
                </Border.Effect>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Title -->
                    <TextBlock Grid.Column="0" Text="🐛 Debug Console" FontSize="16" Foreground="#00d9ff" VerticalAlignment="Center" Margin="20,0,0,0" FontWeight="Bold"/>

                    <!-- Close button -->
                    <Button Grid.Column="1" Content="✕" FontSize="18" Click="CloseButton_Click"
                           Background="#2a2a3e99" Foreground="#ff3333" Padding="15,10" 
                           BorderThickness="0" Cursor="Hand" Margin="10">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}" CornerRadius="6">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </Grid>
            </Border>

            <!-- Debug Output -->
            <Border Grid.Row="1" Background="#1a1a2e" BorderThickness="0,1,0,1" BorderBrush="#333333" Margin="10">
                <Grid>
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
                        <TextBox x:Name="DebugTextBox" 
                                 Background="#0f0f1e"
                                 Foreground="#00d9ff"
                                 BorderThickness="0"
                                 Padding="10"
                                 IsReadOnly="True"
                                 FontFamily="Consolas"
                                 FontSize="11"
                                 TextWrapping="Wrap"
                                 VerticalAlignment="Stretch"/>
                    </ScrollViewer>
                </Grid>
            </Border>

            <!-- Bottom toolbar -->
            <Border Grid.Row="2" Background="#1a1a2e99" BorderThickness="0,1,0,0" BorderBrush="#333333" Padding="10">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Clear" Click="ClearButton_Click"
                           Background="#404040" Foreground="#ffffff" 
                           Padding="10,6" BorderThickness="0" Cursor="Hand" Margin="0,0,10,0">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}" CornerRadius="4">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                    <Button x:Name="AutoScrollButton"
                           Content="Auto-scroll: ON"
                           Click="AutoScrollButton_Click"
                           Background="#00d9ff" Foreground="#0f0f1e" 
                           Padding="10,6" BorderThickness="0" Cursor="Hand">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}" CornerRadius="4">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>
