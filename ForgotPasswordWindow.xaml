<Window x:Class="SkyboundLauncher.ForgotPasswordWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Forgot Password" 
        Height="450" 
        Width="800"
        WindowStartupLocation="CenterScreen"
        Background="#0f0f1e"
        Foreground="#ffffff"
        WindowStyle="None"
        AllowsTransparency="True"
        ResizeMode="CanResizeWithGrip"
        Loaded="Window_Loaded">

    <Window.Resources>
        <!-- Purple-White Gradient Brush -->
        <LinearGradientBrush x:Key="PurpleWhiteGradient" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#9933FF" Offset="0"/>
            <GradientStop Color="#FFFFFF" Offset="1"/>
        </LinearGradientBrush>
    </Window.Resources>

    <Border BorderThickness="1" BorderBrush="#333333" CornerRadius="0">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="50"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Title bar -->
            <Border Grid.Row="0" Background="#1a1a2e99" BorderThickness="0,0,0,1" BorderBrush="{StaticResource PurpleWhiteGradient}" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Border.Effect>
                    <DropShadowEffect Color="#00d9ff" BlurRadius="8" ShadowDepth="0" Opacity="0.3"/>
                </Border.Effect>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Title -->
                    <TextBlock Grid.Column="0" Text="🔑 Forgot Password?" FontSize="16" Foreground="#00d9ff" VerticalAlignment="Center" Margin="20,0,0,0" FontWeight="Bold"/>

                    <!-- Close button -->
                    <Button Grid.Column="1" Content="✕" FontSize="18" Click="CloseButton_Click"
                           Background="#2a2a3e99" Foreground="#ff3333" Padding="15,10" 
                           BorderThickness="0" Cursor="Hand" Margin="10">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}" CornerRadius="6">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </Grid>
            </Border>

            <!-- Form Content -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="30,20" Orientation="Vertical" VerticalAlignment="Top">
                    <!-- Main title -->
                    <TextBlock Text="Chceš změnit heslo k svému účtu?" FontSize="18" Foreground="#00d9ff" FontWeight="Bold" Margin="0,0,0,20" TextAlignment="Center"/>

                    <!-- Username field -->
                    <TextBlock Text="Username:" FontSize="12" Foreground="#cccccc" Margin="0,0,0,5"/>
                    <TextBox x:Name="UsernameTextBox" 
                             Background="#1a1a2e" 
                             Foreground="#ffffff" 
                             BorderBrush="#333333" 
                             BorderThickness="1"
                             Padding="10,8"
                             Margin="0,0,0,15"
                             FontSize="12"/>

                    <!-- Email field -->
                    <TextBlock Text="Email:" FontSize="12" Foreground="#cccccc" Margin="0,0,0,5"/>
                    <TextBox x:Name="EmailTextBox" 
                             Background="#1a1a2e" 
                             Foreground="#ffffff" 
                             BorderBrush="#333333" 
                             BorderThickness="1"
                             Padding="10,8"
                             Margin="0,0,0,15"
                             FontSize="12"/>

                    <!-- Discord Username field -->
                    <TextBlock Text="Discord Username (pro oznámení o změně):" FontSize="12" Foreground="#cccccc" Margin="0,0,0,5"/>
                    <TextBox x:Name="DiscordUsernameTextBox" 
                             Background="#1a1a2e" 
                             Foreground="#ffffff" 
                             BorderBrush="#333333" 
                             BorderThickness="1"
                             Padding="10,8"
                             Margin="0,0,0,25"
                             FontSize="12"/>

                    <!-- Submit button -->
                    <Button x:Name="SubmitButton"
                            Content="Odeslat"
                            Click="SubmitButton_Click"
                            Background="#00d9ff"
                            Foreground="#0f0f1e"
                            Padding="20,8"
                            FontSize="12"
                            FontWeight="Bold"
                            Cursor="Hand"
                            BorderThickness="0"
                            Width="120"
                            HorizontalAlignment="Center">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}" CornerRadius="6">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>

                    <!-- Status message -->
                    <TextBlock x:Name="StatusMessage" 
                               Text="" 
                               FontSize="11" 
                               Foreground="#cccccc" 
                               Margin="0,15,0,0" 
                               TextAlignment="Center"
                               TextWrapping="Wrap"/>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Border>
</Window>
