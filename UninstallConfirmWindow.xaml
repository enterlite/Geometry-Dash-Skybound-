<Window x:Class="SkyboundLauncher.UninstallConfirmWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Potvrdit odinstalaci" 
        Width="450" 
        Height="280"
        WindowStartupLocation="CenterScreen"
        Background="Transparent"
        Foreground="#b0b0c0"
        WindowStyle="None"
        AllowsTransparency="True">
    <Border Background="#0a0e27" CornerRadius="12">
        <Grid Background="#0a0e27">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="30">
                <!-- Title -->
                <TextBlock Text="Potvrdit odinstalaci" 
                           FontSize="20" 
                           FontWeight="Bold" 
                           Foreground="#00d9ff" 
                           Margin="0,0,0,20"
                           TextAlignment="Center"/>
                
                <!-- Message -->
                <TextBlock Text="Opravdu chcete odinstalovat Skybound?" 
                           FontSize="14" 
                           Foreground="#b0b0c0" 
                           Margin="0,0,0,15"
                           TextWrapping="Wrap"
                           TextAlignment="Center"/>
                
                <!-- Checkbox for deleting files -->
                <CheckBox x:Name="DeleteFilesCheckBox"
                          Content="Smazat i soubory hry" 
                          Foreground="#b0b0c0"
                          FontSize="13"
                          Margin="0,0,0,25"
                          Padding="5,0,0,0"
                          IsChecked="False"/>
                
                <!-- Warning message -->
                <TextBlock Text="⚠️ Tato akce nemůže být vrácena zpět!" 
                           FontSize="12" 
                           Foreground="#ff6b6b" 
                           Margin="0,0,0,20"
                           TextAlignment="Center"
                           FontWeight="Bold"/>
                
                <!-- Buttons -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0">
                    <!-- Cancel Button -->
                    <Button x:Name="CancelButton"
                            Content="Zrušit" 
                            Width="120" 
                            Height="40" 
                            Margin="0,0,15,0"
                            Background="#1a1a2e"
                            Foreground="#b0b0c0"
                            BorderBrush="#444466"
                            BorderThickness="2"
                            FontSize="13"
                            FontWeight="SemiBold"
                            Cursor="Hand"
                            Click="CancelButton_Click"/>
                    
                    <!-- Confirm Button -->
                    <Button x:Name="ConfirmButton"
                            Content="Ano, Odinstalovat" 
                            Width="180" 
                            Height="40"
                            Background="#ff3333"
                            Foreground="#ffffff"
                            BorderBrush="#ff0000"
                            BorderThickness="2"
                            FontSize="13"
                            FontWeight="SemiBold"
                            Cursor="Hand"
                            Click="ConfirmButton_Click"/>
                </StackPanel>
            </StackPanel>
        </Grid>
    </Border>
</Window>
